# =============================================================================
# ACTIVE AGE — ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Projeto Integrador Fatec Diadema — DSM 4º Semestre (DevOps & Sistemas Distribuídos)
# =============================================================================

# BANCO DE DADOS (MongoDB Atlas ou Container Local)
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/active_age

# SEGURANÇA E AUTENTICAÇÃO (JWT)
JWT_SECRET=ActiveAgeSuperSecureKeySecret2026JwtTokenSignature!

# GATEWAY DE PAGAMENTOS (Mercado Pago Sandbox)
MERCADO_PAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# INTEGRAÇÃO ENTRE MICROSSERVIÇOS (Rede Docker ou Local)
MS_PAGAMENTO_URL=http://localhost:8082
BACKEND_CORE_URL=http://localhost:8080

# CORS & ORIGENS PERMITIDAS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://active-age.vercel.app
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://active-age.vercel.app
