# ==============================================================================
# ACTIVE AGE - BACKEND CORE (VARIÁVEIS DE AMBIENTE LOCAIS)
# ==============================================================================
# Copie este arquivo para um arquivo local ou configure as variáveis no seu terminal/IDE.
# NUNCA commite senhas reais ou strings de conexão com credenciais no Git.
# ==============================================================================

# Porta da aplicação (padrão local: 8080)
PORT=8080

# String de conexão com o MongoDB Atlas
# Substitua pelos dados do cluster da equipe ou use mongodb://localhost:27017/activeage se rodar MongoDB local
MONGO_URI=mongodb+srv://<USUARIO>:<SENHA>@cluster0.xxxxx.mongodb.net/activeage?retryWrites=true&w=majority

# Chave secreta para assinatura dos tokens JWT (mínimo de 256 bits / 32 caracteres)
JWT_SECRET=sua-chave-secreta-para-ambiente-de-desenvolvimento-local-min-32-chars
